# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, used for privileged admin operations (e.g. inviting users).
# NEVER expose this to the browser / NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical URLs, sitemap.xml, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback Telegram link used when a product has no telegram_link override.
# Editable later from /admin/settings — this is only the seed default.
NEXT_PUBLIC_DEFAULT_TELEGRAM_LINK=https://t.me/CloudCredaSupport
